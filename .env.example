DATABASE_URL=sqlite:data.db
SERVER_HOST=0.0.0.0
SERVER_PORT=3000

# Geocoding cascade, tried in this order per hospital, first success
# wins: census -> nominatim -> google_maps. All three are real
# implementations (see IMPLEMENTATION_NOTES.md) gated by their own
# *_ENABLED flag below. Census is free/keyless and usually the highest
# first-try hit rate, so it's on by default. Nominatim self-throttles to
# 1 req/sec against the public instance regardless of ENRICH_CONCURRENCY
# below, per its usage policy. Google Maps is paid and off by default —
# it's the fallback for addresses neither free provider can resolve
# (PO-box-only addresses, mostly); needs GEOCODING_GOOGLE_MAPS_API_KEY set
# when enabled.
GEOCODING_CENSUS_ENABLED=true
GEOCODING_NOMINATIM_ENABLED=true
GEOCODING_GOOGLE_MAPS_ENABLED=false
GEOCODING_GOOGLE_MAPS_API_KEY=

# Google Places (New) — website-discovery fallback for when Nominatim's
# opportunistic extratags.website comes up empty. Separate API/key from
# GEOCODING_GOOGLE_MAPS_API_KEY above (Maps *Geocoding* is a different
# product/SKU) — enable "Places API (New)" in Google Cloud Console for
# this key, not just "Geocoding API". Disabled by default: with no key
# set, enrichment still runs, it just won't have a fallback beyond
# whatever Nominatim happens to know.
GOOGLE_PLACES_ENABLED=false
GOOGLE_PLACES_API_KEY=

# Enrichment (Stage 2) settings.
ENRICH_CONCURRENCY=10
# How many un-enriched hospitals one POST /api/pipeline/enrich call
# processes. Kept well below "all ~5-6k hospitals" on purpose — with
# Nominatim in the cascade every geocode call is serialized to ~1/sec, so
# a full run would take well over an hour in a single job. Call the
# endpoint repeatedly (by hand or on a schedule) to work through the
# backlog in batches instead of raising this a lot.
#
# Once a batch has run, "enriched_at IS NULL" no longer selects those
# hospitals even if a provider couldn't resolve them — that's deliberate
# (see db::queries::save_enrichment's doc comment), but it means calling
# POST /api/pipeline/enrich again processes nothing further. To go back
# and fill in whatever's still missing (no coordinates, no website), add
# ?retry_incomplete=true to the request — e.g.
# `curl -X POST 'http://localhost:3000/api/pipeline/enrich?retry_incomplete=true'`.
# Opt-in on purpose: without the flag, a normal call never re-spends a
# throttled Nominatim call or a paid Places call on an address that's
# already been tried.
ENRICH_BATCH_LIMIT=200

# Probe settings (compliance-probe is a stub — see IMPLEMENTATION_NOTES.md)
PROBE_CONCURRENCY=10
PROBE_RATE_LIMIT_PER_SEC=5.0
